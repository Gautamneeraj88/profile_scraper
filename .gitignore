# A live LinkedIn session.  Anyone with either of these can use the account:
# .chrome-profile/ is a signed-in Chrome profile, cookies included, and is 92 MB.
storage_state.json
*.storage_state.json
.chrome-profile/
chrome-profile/
*.chrome-profile/

# Real people.  Scraped profiles and candidate lists are personal data and do
# not belong in a public repository.  The test corpus lives in out/ and is
# shared privately instead; tests_engine.py skips those groups when it is
# absent, so a fresh clone still builds.
out/
*_enriched.csv
*_enriched.xlsx
_input_sheet.csv
sheet.csv
candidates*.csv
candidates*.xlsx

# Run history: names, URLs, sometimes the account being used.
*.log
logs/

# Local settings, which contain the LinkedIn email.
config.json

